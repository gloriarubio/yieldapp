# Copia a .env.local (gitignored). En la máquina de trabajo se regenera desde Bitwarden: scripts/pull-secrets.sh
# Producción: estas mismas variables viven en Netlify (netlify env:set) y las de Stripe en Convex (npx convex env set).
BETTER_AUTH_SECRET=<secreto-aleatorio-largo>
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
CONVEX_ADAPTER_SECRET=<secreto-compartido-con-convex>
CONVEX_DEPLOYMENT=<dev:nombre-del-deployment>
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site
LLAMAPARSE_API_KEY=<llx-...>
ANTHROPIC_API_KEY=<sk-ant-...>
